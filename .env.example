# ARLAW AI uses Groq cloud inference only. No Gemini, Ollama or local model downloads.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
ARLAW_HOSTED_TIMEOUT=90
ARLAW_TOP_K=5
ARLAW_MULTI_MODEL_REVIEW=false

# Reliability defaults (Groq TPM-aware)
ARLAW_MAX_COMPLETION_TOKENS=1200
ARLAW_HOSTED_TIMEOUT=90
