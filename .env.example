# Provider priority: first available provider wins; failures automatically fall through.
ARLAW_PROVIDER_ORDER=groq,ollama,openai_compatible

# Optional Groq hosted inference (free-tier availability/limits depend on Groq).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local Ollama inference; no API subscription required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
ARLAW_LOCAL_TIMEOUT=240

# Optional OpenAI-compatible endpoint. Leave blank to disable it.
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_API_KEY=
ARLAW_HOSTED_TIMEOUT=90

ARLAW_TOP_K=5

# Optional independent model review. Requires at least two configured/reachable providers.
# The reviewer output is displayed separately and is not legal verification.
ARLAW_MULTI_MODEL_REVIEW=false

# Optional task-specific provider priority (valid names: groq,ollama,openai_compatible).
# Omit a route to use ARLAW_PROVIDER_ORDER.
ARLAW_ROUTE_LEGAL_RESEARCH=groq,ollama
ARLAW_ROUTE_CIVIL_PROCEDURE=groq,ollama
ARLAW_ROUTE_FINANCE_TAX=groq,ollama
ARLAW_ROUTE_DOCUMENT_REVIEW=groq,ollama
ARLAW_ROUTE_TRANSLATION=ollama,groq
ARLAW_ROUTE_GENERAL=groq,ollama
