# ARLAW AI Global 3.0.0
# Put secrets in your hosting provider's secret environment settings.
# Never commit a populated .env file or share it in ZIP archives.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Local inference (optional; hosted Render instances generally use Groq).
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=2048

# Provider routing
ARLAW_PROVIDER_ORDER=groq,ollama
ARLAW_HOSTED_TIMEOUT=90
ARLAW_TOP_K=8
ARLAW_MULTI_MODEL_REVIEW=false
ARLAW_MAX_COMPLETION_TOKENS=1200

# Storage: point this at a persistent mounted volume in production.
# Example for a Render persistent disk mounted at /var/data:
# ARLAW_DATA_DIR=/var/data
# ARLAW_DB_PATH=/var/data/arlaw.db
# ARLAW_UPLOAD_DIR=/var/data/uploads

# Abuse and upload safeguards
ARLAW_MAX_UPLOAD_BYTES=20971520
ARLAW_MAX_PDF_PAGES=300
ARLAW_CHAT_RATE_LIMIT=20
ARLAW_UPLOAD_RATE_LIMIT=5
