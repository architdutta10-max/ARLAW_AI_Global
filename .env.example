
# Provider selection: auto, groq, openai, ollama
ARLAW_AI_PROVIDER=auto

# Groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI-compatible provider
ARLAW_OPENAI_API_KEY=
ARLAW_OPENAI_BASE_URL=https://api.openai.com/v1
ARLAW_OPENAI_MODEL=

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b

# Model settings
ARLAW_MODEL_TIMEOUT=120
ARLAW_MAX_COMPLETION_TOKENS=1800
ARLAW_TOP_K=5
