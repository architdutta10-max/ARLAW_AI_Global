# ARLAW AI Global 2.3.0 — Hybrid local/cloud model routing
# Put your Groq key here if you want cloud fallback. Keep this file private.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Ollama local model. Install Ollama separately, then pull the model.
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_PREDICT=2048

# Provider preference: groq,ollama or ollama,groq
# Ollama-first uses your local model when available, then falls back to Groq.
ARLAW_PROVIDER_ORDER=ollama,groq
ARLAW_HOSTED_TIMEOUT=90
ARLAW_TOP_K=8
ARLAW_MULTI_MODEL_REVIEW=false
ARLAW_MAX_COMPLETION_TOKENS=1200
